    },
    "Choose an empty folder to move your library there, or a folder that already has an Anvi library to open it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリを移動するには空のフォルダを、既存のAnviライブラリを開くにはそのフォルダを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta vazia para mover sua biblioteca para lá, ou uma pasta que já tenha uma biblioteca do Anvi para abri-la."
          }
        }
      }
    },
    "Choose one or more exported Anvi decks (.json).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したAnviのデッキ（.json）を1つ以上選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um ou mais decks exportados do Anvi (.json)."
          }
        }
      }
    },
    "Could not create the library folder.": {
      "localizations": {
        "ja": {
