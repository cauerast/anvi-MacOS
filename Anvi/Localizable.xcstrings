    "Create a deck, add a few cards and study a little every day. Everything stays on this Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッキを作ってカードを追加し、毎日少しずつ学習しましょう。データはすべてこのMacに保存されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um deck, adicione alguns cards e estude um pouco todo dia. Tudo fica neste Mac."
